# Copier ce fichier en ".env" a la racine de spark_project.
# Lu par settings.py pour se connecter a postgres-raw. Si vous changez ces
# valeurs, mettez aussi a jour le service postgres-raw dans
# spark_project/docker-compose.yaml pour qu'il reste en phase.
RAW_DB_HOST=postgres-raw
RAW_DB_PORT=5432
RAW_DB_NAME=raw_data
RAW_DB_USER=raw
RAW_DB_PASSWORD=raw
RAW_DB_TABLE=raw.retail_sales
RAW_DB_STATS_TABLE=raw.retail_sales_stats
STAGING_DB_TABLE=staging.retail_sales
STAGING_DB_REJECTED_TABLE=staging.retail_sales_rejected
INTERMEDIATE_MONTHLY_BY_PRODUCT_TABLE=intermediate.monthly_sales_by_product
INTERMEDIATE_DAILY_BY_PRODUCT_TABLE=intermediate.daily_sales_by_product
INTERMEDIATE_MONTHLY_BY_STORE_TABLE=intermediate.monthly_sales_by_store
INTERMEDIATE_DAY_NAME_BY_PRODUCT_TABLE=intermediate.sales_by_day_name_by_product
TRAINING_PRODUCT_MONTH_TABLE=training.product_month_features
PARQUET_EXPORT_DIR=/opt/spark-data/exports

# Optionnel : necessaire uniquement pour export/snowflake_loader.py (charger
# les Parquet exportes ci-dessus dans Snowflake). Laisser vide si non utilise.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=
