# Copier ce fichier en ".env" a la racine de airflow_project
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Dependances python additionnelles installees au demarrage des conteneurs (optionnel)
_PIP_ADDITIONAL_REQUIREMENTS=
# Identifiants API Kaggle (https://www.kaggle.com/settings -> Create New API Token),
# requis par les DAGs qui telechargent un dataset Kaggle.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optionnel : necessaire uniquement pour export/snowflake_loader.py (charger
# les Parquet exportes ci-dessus dans Snowflake). Laisser vide si non utilise.
SNOWFLAKE_USER=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=
